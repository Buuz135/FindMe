{
  "schemaVersion": 1,
  "id": "findme",
  "version": "${version}",
  "name": "FindMe",
  "description": "FindMe allows you to search for items in nearby inventories by pressing a key.",
  "authors": [
    "Buuz135"
  ],
  "contact": {
    "homepage": "https://github.com/Buuz135/FindMe",
    "sources": "https://github.com/Buuz135/FindMe",
    "issues": "https://github.com/Buuz135/FindMe/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.buuz135.findme.fabric.FindMeFabric"
    ],
    "client": [
      "com.buuz135.findme.fabric.FindMeClientFabric"
    ]
  },
  "mixins": [
    "findme-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": ">=0.150.0",
    "minecraft": "26.1.2",
    "java": ">=25",
